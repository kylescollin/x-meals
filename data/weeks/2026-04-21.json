  "meals": [
    {
      "date": "4/21",
      "day": "Tuesday",
      "icon": "🌶️",
      "id": "slow-cooker-chili",
      "ings": [
        "1 Tbsp olive oil",
        "2 lbs lean ground beef",
        "1 large yellow onion, finely chopped",
        "3 cloves garlic, finely minced",
        "2 (14.5 oz) cans diced tomatoes with mild green chilies",
        "3 (8 oz) cans tomato sauce",
        "½ cup beef broth",
        "2 Tbsp chili powder",
        "2½ tsp ground cumin",
        "2 tsp paprika",
        "2 tsp unsweetened cocoa powder",
        "1 tsp granulated sugar",
        "½ tsp ground coriander",
        "Salt and freshly ground black pepper",
        "1 (15 oz) can dark red kidney beans, drained",
        "1 (15 oz) can light red kidney beans, drained",
        "Toppings: shredded cheddar, sour cream, sliced green onions"
      ],
      "label": "Meal A",
      "meta": "~15 min prep · 6 hrs slow cooker · Serves 8",
      "name": "Slow Cooker Chili",
      "note": "💡 Set up Monday morning — dinner is hands-off by Tuesday. Makes 8 servings; freeze half.",
      "steps": [
        "Set up Monday morning. Sauté onion 3 min in olive oil, add garlic 30 sec. Transfer to slow cooker.",
        "Brown ground beef in same skillet. Drain fat. Add to slow cooker.",
        "Stir in all remaining ingredients. Season with salt and pepper.",
        "Cover and cook on LOW 5–6 hours (or HIGH 3 hours).",
        "Stir in kidney beans. Heat through 2 min.",
        "Serve with cheddar, sour cream, and green onions."
      ]
    },
    {
      "date": "4/22",
      "day": "Wednesday",
      "icon": "🧈",
      "id": "butter-cauliflower",
      "ings": [
        "1 medium head cauliflower, cut into florets",
        "2 Tbsp olive oil (divided)",
        "2 tsp fresh lemon juice",
        "2 tsp cornstarch",
        "½ tsp ground cumin",
        "1 tsp ground turmeric (divided)",
        "3 tsp garam masala (divided)",
        "1½ tsp salt (divided)",
        "3 Tbsp unsalted butter",
        "1 yellow onion, finely chopped",
        "3 garlic cloves, minced",
        "2 tsp fresh ginger, grated",
        "2 Tbsp tomato paste",
        "1 tsp paprika",
        "¼ tsp ground cinnamon",
        "1 (8 oz) can plain tomato sauce",
        "2 cups vegetable broth",
        "½ cup heavy cream",
        "Basmati rice for serving",
        "Fresh cilantro + plain Greek yogurt to garnish"
      ],
      "label": "Meal B",
      "meta": "~65 min · One pan · Vegetarian · Serves 4",
      "name": "Butter Cauliflower",
      "note": "💡 The double-cook on the cauliflower is what makes this dish. Skip cayenne for the kids.",
      "steps": [
        "Mix lemon juice, cornstarch, ½ tsp cumin, ½ tsp turmeric, 1 tsp garam masala, ½ tsp salt in a bowl.",
        "Sear cauliflower in 1 tbsp oil 7–8 min. Toss in cornstarch mixture, return to skillet, cook 7–8 more min. Remove to bowl.",
        "Add remaining oil and butter. Sauté onion 8 min. Add garlic, ginger, tomato paste; cook 2 min. Add spices; toast 1 min.",
        "Add tomato sauce and broth. Simmer. Stir in cream, return cauliflower. Simmer 15 min.",
        "Serve over basmati rice with cilantro and Greek yogurt."
      ]
    },
    {
      "date": "4/23",
      "day": "Thursday",
      "icon": "🍝",
      "id": "turkey-veggie-bolognese-casarecce",
      "ings": [
        "12 oz casarecce pasta (or mafaldine)",
        "3 Tbsp extra virgin olive oil",
        "1 medium onion, diced",
        "4 cloves garlic, minced",
        "1½ lbs ground turkey (93% lean)",
        "1 medium zucchini, diced",
        "8 oz cremini mushrooms, sliced",
        "1 tsp granulated garlic",
        "Salt and freshly ground black pepper",
        "3 Tbsp tomato paste",
        "1 (28 oz) can crushed tomatoes",
        "1 (14 oz) can tomato puree",
        "1 tbsp fresh basil, chopped (or 1 tsp dried)",
        "1 tsp sugar",
        "Parmesan, for serving"
      ],
      "label": "Meal C",
      "meta": "~50 min · One pot · Serves 4–6",
      "name": "Turkey & Veggie Bolognese over Casarecce",
      "note": "💡 Can't find casarecce? Rigatoni or mafaldine work great. Sauce freezes well — make a full batch and stash half.",
      "steps": [
        "Sauté onion 5–7 min in olive oil. Add garlic, cook 30 sec.",
        "Add turkey, brown 7–8 min. Season with granulated garlic, salt, pepper.",
        "Add zucchini and mushrooms. Cook 4–5 min until softened.",
        "Stir in tomato paste, cook 2 min.",
        "Add crushed tomatoes, puree, sugar, basil. Simmer uncovered 30–35 min until thick.",
        "Cook casarecce al dente. Reserve 1 cup pasta water. Toss pasta with sauce.",
        "Serve with generous Parmesan."
      ]
    }
  ],
